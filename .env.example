# ==============================================================
# CareerAI Frontier Engine Configuration (.env.example)
# ==============================================================

# Default Provider: gemini | openai | ollama
AI_PROVIDER=gemini

# 1. Google Gemini Frontier Tier
GEMINI_API_KEY=your_gemini_api_key_here
# Available Frontier Models:
# - gemini-2.5-pro                (Flagship Frontier: PhD-level reasoning)
# - gemini-2.0-pro-exp-02-05      (Experimental Pro: Elite engineering & systems design)
# - gemini-2.0-flash-thinking-exp-01-21 (Deep Chain-of-Thought Reasoning Model)
# - gemini-1.5-pro                (Stable Enterprise Pro)
GEMINI_MODEL=gemini-2.5-pro

# 2. OpenAI Frontier Tier (Optional)
OPENAI_API_KEY=your_openai_api_key_here
# - o3-mini                       (SOTA STEM, coding & deep reasoning)
# - o1                            (High-depth step-by-step reasoning)
# - gpt-4o                        (Flagship Omni Multimodal)
OPENAI_MODEL=gpt-4o

# 3. Ollama Local LLM (Optional - 100% Free & Offline)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.3
